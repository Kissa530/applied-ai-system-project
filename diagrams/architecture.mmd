flowchart TD
    IN1([Structured profile<br/>genre, mood, energy, tempo])
    IN2([Free-text request<br/>e.g. 'something calm to study to'])

    IN2 --> PFT["retriever.profile_from_text<br/>keyword search of the knowledge base<br/>genre set only if named"]
    PFT -- no match --> NOMATCH[/"Ask user to name a mood or genre"/]
    PFT --> VAL
    IN1 --> VAL

    subgraph GUARD["1. Guardrails - src/guardrails.py"]
        VAL["validate_profile<br/>reject empty or non-numeric input<br/>clamp out-of-range values<br/>warn on unknown labels"]
    end

    VAL -- rejected --> REJ[/"Rejected with clear error"/]
    VAL -- "clean profile" --> RET

    subgraph RAG["2. Retrieval - src/retriever.py"]
        KB[("knowledge/taste_kb.json<br/>descriptions + related weights")]
        RET["KnowledgeBase.retrieve<br/>look up the user's genre and mood"]
        KB --> RET
    end

    subgraph CORE["3. Recommender - src/recommender.py"]
        SC["score_song_rag<br/>original score + partial credit<br/>for related genre and mood"]
        RANK["Rank songs, keep top K"]
        EXPL["build_explanation<br/>uses the retrieved descriptions"]
        CONF["Confidence = score / 4.5<br/>flag low confidence and energy gap"]
        SC --> RANK --> EXPL --> CONF
    end

    CSV[("data/songs.csv")] --> SC
    RET -- "related weights + descriptions" --> SC
    KB -. "file missing: baseline scoring" .-> RANK

    CONF --> OUT([Top K songs with score,<br/>confidence, explanation, flags])
    OUT --> HUMAN{{"Human review<br/>reads the flags and decides<br/>whether to trust each pick"}}

    TESTS["Automated checks<br/>pytest: 50 tests<br/>src/evaluate.py: 16 checks, before vs after"]
    TESTS -. "feeds fixed inputs" .-> VAL
    TESTS -. "verifies results" .-> OUT

    LOG[("logs/app.log")]
    GUARD -.-> LOG
    RAG -.-> LOG
    CORE -.-> LOG
